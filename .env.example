# ─────────────────────────────────────────────────────────────────────────────
# TrendFinder environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------------------------
# APP_MODE controls affiliate behaviour ONLY. Everything else works identically.
#   TEST       -> Buy button uses the plain AliExpress product URL. No affiliate
#                 credentials required. Fully deployable as-is.
#   PRODUCTION -> Buy button uses affiliate deep links. Requires the ALIEXPRESS_*
#                 variables below; the app refuses to publish links otherwise.
APP_MODE=TEST

# Public site URL (used for SEO canonical URLs, sitemap, Open Graph).
SITE_URL=http://localhost:3000

# IANA timezone for the daily scheduler. DST is handled automatically.
TIMEZONE=Asia/Jerusalem

# Node environment
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://trendfinder:trendfinder@localhost:5432/trendfinder?schema=public

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for trend research + AliExpress research. Must support the
# Responses API and the `web_search` tool.
OPENAI_MODEL=gpt-4.1
# Optional: separate, cheaper model for scoring/classification calls.
OPENAI_MODEL_LIGHT=gpt-4.1-mini
# Set to `mock` to run the whole pipeline with a deterministic fake provider
# (no API calls, no key needed). Useful for CI and offline development.
#   values: openai | mock
AI_PROVIDER=openai

# --- Admin authentication --------------------------------------------------
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate with:
#   npx tsx scripts/hash-password.ts 'your-password'
# IMPORTANT: escape every '$' in the hash as '\$' — the env loader performs
# variable interpolation and would otherwise blank the value.
# e.g. a hash "$2a$10$abc..." becomes:
ADMIN_PASSWORD_HASH=\$2a\$10\$replace_this_with_a_real_bcrypt_hash_value_000000000000
# Secret used to sign the admin session JWT. Use a long random string:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Scheduler / cron -------------------------------------------------------
# Shared secret required to call POST /api/cron/generate (the HTTP trigger used
# as an alternative / backup to the in-process node-cron worker).
CRON_SECRET=change-me-to-a-random-cron-secret
# When true, the worker process runs the node-cron schedule. Set to false if you
# drive generation exclusively via the HTTP endpoint + system crontab.
ENABLE_INPROCESS_CRON=true

# --- Currency --------------------------------------------------------------
# Base currency the pipeline normalises AliExpress prices FROM when the listing
# currency is unknown (rarely needed).
CURRENCY_BASE=USD
# Target display currency. The public site always shows this.
CURRENCY_DISPLAY=ILS
# Currency conversion provider:
#   erapi       - open.er-api.com, free, no key, live daily USD->ILS rate (default)
#   frankfurter - ECB rates, free, no key — but DOES NOT support ILS
#   fixed       - always use CURRENCY_FIXED_USD_ILS
CURRENCY_PROVIDER=erapi
# Fallback fixed rate used only if the live provider is unreachable (1 USD = X ILS).
CURRENCY_FIXED_USD_ILS=3.7

# --- Affiliate (OPTIONAL — only used when APP_MODE=PRODUCTION) --------------
# Your AliExpress Portals tracking id (portals.aliexpress.com -> Tracking ID).
ALIEXPRESS_AFFILIATE_ID=
# Your AliExpress Open Platform app credentials (openservice.aliexpress.com -> App Info).
ALIEXPRESS_AFFILIATE_KEY=
ALIEXPRESS_AFFILIATE_SECRET=
# Link strategy:
#   api     -> official aliexpress.affiliate.link.generate call (needs ID+KEY+SECRET) [recommended]
#   s.click -> unsigned tracking wrapper (needs only ID; weak attribution)
#   portals -> locally-signed param wrap (legacy)
ALIEXPRESS_AFFILIATE_STRATEGY=api
# Override only if AliExpress gives you a region-specific gateway.
ALIEXPRESS_API_ENDPOINT=https://api-sg.aliexpress.com/sync

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info
